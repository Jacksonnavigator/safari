# Example env file — do NOT commit secrets to Git.
# Copy to .env and fill with your values when running locally.

PORT=3000
NODE_ENV=production
# Example API key placeholder (set in Render dashboard as a secret)
EXAMPLE_API_KEY=your_api_key_here

# Add other secret keys your app needs, for example:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# VITE_SOME_PUBLIC_KEY=public_value
